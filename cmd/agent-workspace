#!/usr/bin/env bash
# The agent workspace from the shell: a crew of coding agents on one project
# (config/agent-workspace.el), for your scripts. See docs/agent-workspace.md.
#
#   agent-workspace new --role ROLE [--name NAME] [--prompt TEXT]
#                                a new agent in this folder's project: its
#                                worktree made, its session started; NAME
#                                left out, one is made for it; TEXT its
#                                first message -> {"ok": true, "name",
#                                "role", "worktree", "branch", "state"}
#   agent-workspace crew NAME    the agents the crew file NAME has that this
#                                folder's project's crew lacks, made at once
#                                (none if it lacks nothing) -> {"ok": true,
#                                "made": [{"name", "role", "worktree",
#                                "branch", "state"}...]}; those not made too,
#                                "failed": [{"role", "error"}...]
#   agent-workspace send --to NAME|#ROLE|#all [--from SOURCE] TEXT|-
#                                an event for an agent, a role's first free
#                                agent or every agent (TEXT, or - for stdin),
#                                from SOURCE (default: shell): delivered when
#                                it's free, as data, never instructions
#                                -> {"ok": true, "events": [{"id", "to",
#                                "state": "queued"|"delivered"}]}; from an
#                                agent's session: its message to another
#                                agent (no --from), "waiting" for your OK
#                                if the crew asks
#   agent-workspace status       the crew as it is -> {"ok": true, "project",
#                                "agents": [{"name", "role", "state",
#                                "words", "time", "loop", "issue",
#                                "issue_title", "branch", "worktree",
#                                "changed", "asking", "events"}...],
#                                "conflicts": [{"file", "agents"}...],
#                                "offers": [{"issue", "title", "to",
#                                "role"}...], "talk"}
#   agent-workspace give ISSUE --to NAME
#                                ISSUE given to the agent NAME, as t does:
#                                claimed as it, its branch opened, "Work on
#                                ISSUE: TITLE" sent now, or after its turn
#                                -> {"ok": true, "name", ..., "issue",
#                                "prompt": "sent"|"queued"}
#   agent-workspace wake NAME    the agent NAME woken (asleep or gone home)
#   agent-workspace sleep NAME   the agent NAME put to sleep, as Z does
#                                -> {"ok": true, "name", ..., "state"}
#   agent-workspace loop NAME on|off
#                                its loop turned on or off, as L does
#                                -> {"ok": true, "name", ..., "loop"}
#
# --crew NAME, with any of them: the project's crew NAME (default: its
# default crew), from your shell or a script. From an agent's session, its
# own crew, always (another --crew is refused).
#
# give, wake, sleep and loop are said in the room, with who did them (the
# agent, or shell). From an agent's session they're refused unless its role
# leads (leads: true), new and crew too; status works from any. Emacs tells
# an agent's session by this script's process (one of its descendants),
# whatever AGENT_WORKSPACE_AGENT says; elsewhere (yours, a script's) that
# variable's word is taken.
#
# The reply is JSON on stdout: {"ok": false, "error": "what's wrong"} when it
# isn't done. Exit status: 0 done, 1 not done (the reply says why), 2 a wrong
# use, 3 no Emacs to talk to (it runs as a server: M-x server-start).
#
# EMACSCLIENT (default: emacsclient) is the client, EMACS_SOCKET_NAME its
# server. Run outside a desktop session (cron: no XDG_RUNTIME_DIR), it finds
# a desktop Emacs's server in /run/user/UID/emacs/ on Linux, which
# emacsclient alone wouldn't look in.

set -u

usage() { sed -n '2,/^$/{s/^# \{0,1\}//;p;}' "$0"; }

json_string() {  # json_string TEXT: TEXT as a JSON string
  local s=$1 i c u
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  # Every other control character (a log's colours: ESC) as \u00XX: JSON
  # allows none raw.
  for ((i = 1; i < 32; i++)); do
    case $i in 9|10|13) continue ;; esac
    printf -v c "\\x$(printf %02x "$i")"
    [[ $s == *"$c"* ]] || continue
    printf -v u '\\u%04x' "$i"
    s=${s//"$c"/"$u"}
  done
  printf '"%s"' "$s"
}

fail() {  # fail STATUS MESSAGE: the reply for an error, and exit
  printf '{"ok":false,"error":%s}\n' "$(json_string "$2")"
  exit "$1"
}

# --crew NAME, anywhere before a --: taken out, for the payload.
crew="" args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --) args+=("$@"); break ;;
    --crew)
      [ $# -lt 2 ] && fail 2 "--crew: give it a value"
      crew=$2; shift 2 ;;
    --crew=*) crew=${1#--crew=}; shift ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

[ $# -eq 0 ] && { usage >&2; exit 2; }
case "$1" in -h|--help|help) usage; exit 0 ;; esac

op=$1; shift
case "$op" in
  new)
    role="" name="" prompt=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --role|--name|--prompt)
          [ $# -lt 2 ] && fail 2 "$1: give it a value"
          case "$1" in
            --role) role=$2 ;; --name) name=$2 ;; --prompt) prompt=$2 ;;
          esac
          shift 2 ;;
        --role=*) role=${1#--role=}; shift ;;
        --name=*) name=${1#--name=}; shift ;;
        --prompt=*) prompt=${1#--prompt=}; shift ;;
        *) fail 2 "new: unknown argument \"$1\"; agent-workspace new --role ROLE [--name NAME] [--prompt TEXT]" ;;
      esac
    done
    [ -z "$role" ] && fail 2 "new: which role? agent-workspace new --role ROLE"
    payload=$(printf '{"role":%s,"name":%s,"prompt":%s,"agent":%s}' \
                     "$(json_string "$role")" "$(json_string "$name")" "$(json_string "$prompt")" \
                     "$(json_string "${AGENT_WORKSPACE_AGENT:-}")") ;;
  crew)
    [ $# -eq 0 ] && fail 2 "crew: which one? agent-workspace crew NAME"
    case "$1" in -*) fail 2 "crew: unknown argument \"$1\"; agent-workspace crew NAME" ;; esac
    [ $# -gt 1 ] && fail 2 "crew: unknown argument \"$2\"; agent-workspace crew NAME"
    payload=$(printf '{"name":%s,"agent":%s}' "$(json_string "$1")" "$(json_string "${AGENT_WORKSPACE_AGENT:-}")") ;;
  send)
    to="" from="" text="" have_text=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --to|--from)
          [ $# -lt 2 ] && fail 2 "$1: give it a value"
          case "$1" in --to) to=$2 ;; --from) from=$2 ;; esac
          shift 2 ;;
        --to=*) to=${1#--to=}; shift ;;
        --from=*) from=${1#--from=}; shift ;;
        -) text=$(cat); have_text=1; shift ;;
        --) shift; text="$*"; have_text=1; break ;;
        -*) fail 2 "send: unknown argument \"$1\"; agent-workspace send --to NAME|#ROLE|#all [--from SOURCE] TEXT|-" ;;
        *) text="$*"; have_text=1; break ;;
      esac
    done
    [ -z "$to" ] && fail 2 "send: to whom? agent-workspace send --to NAME|#ROLE|#all TEXT"
    [ -z "$have_text" ] && fail 2 "send: what? agent-workspace send --to $to TEXT (or - to read it)"
    agent=""
    [ -z "$from" ] && agent=${AGENT_WORKSPACE_AGENT:-}
    payload=$(printf '{"to":%s,"from":%s,"text":%s,"agent":%s}' \
                     "$(json_string "$to")" "$(json_string "$from")" "$(json_string "$text")" \
                     "$(json_string "$agent")") ;;
  status)
    [ $# -gt 0 ] && fail 2 "status: unknown argument \"$1\"; agent-workspace status"
    payload=$(printf '{"agent":%s}' "$(json_string "${AGENT_WORKSPACE_AGENT:-}")") ;;
  give)
    issue="" to=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --to)
          [ $# -lt 2 ] && fail 2 "$1: give it a value"
          to=$2; shift 2 ;;
        --to=*) to=${1#--to=}; shift ;;
        -*) fail 2 "give: unknown argument \"$1\"; agent-workspace give ISSUE --to NAME" ;;
        *)
          [ -n "$issue" ] && fail 2 "give: unknown argument \"$1\"; agent-workspace give ISSUE --to NAME"
          issue=$1; shift ;;
      esac
    done
    [ -z "$issue" ] && fail 2 "give: which issue? agent-workspace give ISSUE --to NAME"
    [ -z "$to" ] && fail 2 "give: to whom? agent-workspace give $issue --to NAME"
    payload=$(printf '{"issue":%s,"to":%s,"agent":%s}' \
                     "$(json_string "$issue")" "$(json_string "$to")" \
                     "$(json_string "${AGENT_WORKSPACE_AGENT:-}")") ;;
  wake|sleep)
    [ $# -eq 0 ] && fail 2 "$op: whom? agent-workspace $op NAME"
    case "$1" in -*) fail 2 "$op: unknown argument \"$1\"; agent-workspace $op NAME" ;; esac
    [ $# -gt 1 ] && fail 2 "$op: unknown argument \"$2\"; agent-workspace $op NAME"
    payload=$(printf '{"name":%s,"agent":%s}' \
                     "$(json_string "$1")" "$(json_string "${AGENT_WORKSPACE_AGENT:-}")") ;;
  loop)
    [ $# -eq 0 ] && fail 2 "loop: whose? agent-workspace loop NAME on|off"
    case "$1" in -*) fail 2 "loop: unknown argument \"$1\"; agent-workspace loop NAME on|off" ;; esac
    case "${2:-}" in
      on) on=true ;;
      off) on=false ;;
      '') fail 2 "loop: on or off? agent-workspace loop $1 on|off" ;;
      *) fail 2 "loop: \"$2\" isn't on or off; agent-workspace loop $1 on|off" ;;
    esac
    [ $# -gt 2 ] && fail 2 "loop: unknown argument \"$3\"; agent-workspace loop NAME on|off"
    payload=$(printf '{"name":%s,"on":%s,"agent":%s}' \
                     "$(json_string "$1")" "$on" "$(json_string "${AGENT_WORKSPACE_AGENT:-}")") ;;
  *)
    fail 2 "unknown operation \"$op\"; operations: new, crew, send, status, give, wake, sleep, loop" ;;
esac
if [ -n "$crew" ]; then
  if [ "$payload" = '{}' ]; then
    payload=$(printf '{"crew":%s}' "$(json_string "$crew")")
  else
    payload=$(printf '{"crew":%s,%s' "$(json_string "$crew")" "${payload#\{}")
  fi
fi

dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-workspace.XXXXXXXXXX") || fail 3 "no temp folder"
trap 'rm -rf "$dir"' EXIT
# Its own process's id: Emacs tells which agent's session ran it from its
# ancestors, whatever AGENT_WORKSPACE_AGENT says.
printf '%s\n%s\n%s\n' "$op" "$PWD" "$$" >"$dir/request"
printf '%s' "$payload" >"$dir/payload"

# On Linux emacsclient looks for its server under $XDG_RUNTIME_DIR/emacs/, or,
# without that variable (cron), in ${TMPDIR:-/tmp}/emacsUID/ only: a desktop
# Emacs's is in /run/user/UID/emacs/. AGENT_WORKSPACE_RUNTIME_DIR: that
# folder elsewhere (the tests).
if [ -z "${EMACS_SOCKET_NAME:-}" ] && [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  runtime=${AGENT_WORKSPACE_RUNTIME_DIR:-/run/user/$(id -u)}
  [ -S "$runtime/emacs/server" ] && export EMACS_SOCKET_NAME="$runtime/emacs/server"
fi

# The folder as a Lisp string.
lisp_dir=${dir//\\/\\\\}
lisp_dir=${lisp_dir//\"/\\\"}
out=$("${EMACSCLIENT:-emacsclient}" --timeout=60 --eval \
        "(if (fboundp 'agent-workspace-request) (agent-workspace-request \"$lisp_dir\") 'agent-workspace-not-loaded)" 2>&1)
status=$?

if [ -f "$dir/reply" ]; then
  cat "$dir/reply"
  grep -q '^{"ok":true' "$dir/reply" && exit 0
  exit 1
fi
case "$out" in
  *agent-workspace-not-loaded*) fail 3 "Emacs runs, but without the agent workspace (config/agent-workspace.el)" ;;
esac
[ $status -ne 0 ] && fail 3 "no Emacs server answered (M-x server-start): ${out//$'\n'/ }"
fail 3 "Emacs didn't answer: ${out//$'\n'/ }"
