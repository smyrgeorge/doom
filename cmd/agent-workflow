#!/usr/bin/env bash
# Agent workflows from the shell (config/agent-workflow.el): for you, your
# scripts, an agent writing a workflow, and an agent of a run ending its
# step. See docs/agent-workflow.md.
#
#   agent-workflow run ISSUE... [--workflow NAME] [--detach] [--json]
#   agent-workflow run --workflow NAME [--detach] [--json]
#                                runs started on the issues (an epic's id: its
#                                open issues), each with NAME, else its own
#                                workflow; no issue: NAME's own run (a
#                                workflow with no ticket, ticket: false); their logs printed as they go (a
#                                line an event: time, issue, job, what
#                                happened; what needs you says how to answer),
#                                until they all end. Ctrl-C stops following,
#                                never the runs. --json: the reply, then their
#                                journals' lines, each with its "issue".
#                                --detach: the reply only -> {"ok": true when
#                                one started, "started": [{"issue",
#                                "workflow", "run", "state", "why", "log",
#                                "journal", "state_file"}...], "refused":
#                                [{"issue", "error"}...]}. Exit 0 all done, 1
#                                one cancelled or failed (or none started)
#   agent-workflow logs ISSUE [-f] [--json]
#                                ISSUE's latest run's log (--json: its
#                                journal); -f: followed until the run ends
#   agent-workflow status [ISSUE]
#                                ISSUE's latest run, or every run of the
#                                project not over -> {"ok": true, "runs":
#                                [{"issue", "workflow", "run", "state", "why",
#                                "jobs": [{"name", "status", "outcome",
#                                "round", "why"}...], "asking", "spent",
#                                "budget", "log"...}...]}
#   agent-workflow done [OUTCOME] [NOTES|-]
#                                from an agent of a run, in its session: its
#                                step is done, with OUTCOME (default: done)
#                                and NOTES (- reads them from stdin): what
#                                the next jobs and the user need to know;
#                                one argument: a word is the OUTCOME (done
#                                changes), text with spaces the NOTES ->
#                                {"ok": true, "issue", "job", "outcome"}
#   agent-workflow back ISSUE JOB[.STEP] [NOTE|-] [--discard]
#                                ISSUE's run sent back to JOB (its step STEP,
#                                from 1), with NOTE: the branch kept, the jobs
#                                that need JOB run again; --discard: the work
#                                since JOB started gone (its commits, changes
#                                not committed) -> {"ok": true, "issue",
#                                "job", "step", "replaced": [jobs], "lost":
#                                [lines]}
#   agent-workflow confirm ISSUE go|accept|skip|stop|cancel [--note-to JOB NOTE]...
#                                ISSUE's run's question answered: a job that
#                                sent it back too often, or a round that
#                                changed nothing (go on, with a note for a
#                                job; accept it as it is; stop); a step whose
#                                retries are used up (go, a note for the job's
#                                agent fixing it; skip it; stop), one that
#                                broke (go: again; skip; stop), a merge
#                                waiting (go: again; stop), its budget used up
#                                (go, with --more-cost N, --more-tokens N or
#                                --more-time 1h; stop), its issue closed by
#                                hand (go: in progress again; cancel the run)
#                                -> {"ok": true, "issue", "job", "choice"}
#   agent-workflow approve ISSUE
#   agent-workflow reject ISSUE NOTE|-
#                                the result ISSUE's run waits for your OK on
#                                approved (the run goes on), or rejected with
#                                NOTE (back to its agent, or the run stopped)
#                                -> {"ok": true, "issue", "job"}
#   agent-workflow continue [ISSUE] [--current]
#                                interrupted runs continued (Emacs stopped, or
#                                paused at once): ISSUE's, or every one of the
#                                project's; --current: with the workflow as it
#                                is now -> {"ok": true, "continued": [{"issue",
#                                "jobs"}...]}
#   agent-workflow cancel ISSUE  ISSUE's run cancelled: its agents stopped,
#                                its work kept -> {"ok": true, "issue"}
#   agent-workflow pause [--now] nothing new starts; --now: running steps
#                                stopped, interrupted -> {"ok": true, "paused"}
#   agent-workflow unpause       on again -> {"ok": true, "paused": false}
#   agent-workflow dry-run WORKFLOW [--issue ID] [--outcome JOB=OUT,OUT]...
#                          [--exit JOB.N=CODE,CODE]...
#                                WORKFLOW walked, nothing run or changed: its
#                                agents' outcomes a round each (none: done),
#                                step N's exit codes a try each (none: 0), its
#                                if: read from ID (none: one of its first
#                                type) -> {"ok": true, "waves": [[lines]...],
#                                "end": {job: status}, "stopped": why|null}
#   agent-workflow check [FILE]  this folder's project's workflows and
#                                agents read anew and checked, or only FILE
#                                (a workflow, .yml, or an agent, .md,
#                                anywhere) -> {"ok": true when there's no
#                                error, "project", "workflows": [names],
#                                "agents": [names], "problems": [{"level":
#                                "error"|"warning", "file", "line",
#                                "message"}...]}
#
# The reply is JSON on stdout: {"ok": false, "error": "what's wrong"} when it
# isn't done (for check, when it found errors). Exit status: 0 done, 1 not
# done (the reply says why), 2 a wrong use, 3 no Emacs to talk to (it runs
# as a server: M-x server-start).
#
# EMACSCLIENT (default: emacsclient) is the client, EMACS_SOCKET_NAME its
# server. Run outside a desktop session (cron: no XDG_RUNTIME_DIR), it finds
# a desktop Emacs's server in /run/user/UID/emacs/ on Linux, which
# emacsclient alone wouldn't look in.

set -u

usage() { sed -n '2,/^$/{s/^# \{0,1\}//;p;}' "$0"; }

json_string() {  # json_string TEXT: TEXT as a JSON string
  local s=$1 i c u
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  # Every other control character as \u00XX: JSON allows none raw.
  for ((i = 1; i < 32; i++)); do
    case $i in 9|10|13) continue ;; esac
    printf -v c "\\x$(printf %02x "$i")"
    [[ $s == *"$c"* ]] || continue
    printf -v u '\\u%04x' "$i"
    s=${s//"$c"/"$u"}
  done
  printf '"%s"' "$s"
}

fail() {  # fail STATUS MESSAGE: the reply for an error, and exit
  printf '{"ok":false,"error":%s}\n' "$(json_string "$2")"
  exit "$1"
}

[ $# -eq 0 ] && { usage >&2; exit 2; }
detach="" json="" follow=""
case "$1" in -h|--help|help) usage; exit 0 ;; esac

op=$1; shift
case "$op" in
  check)
    case "${1:-}" in -*) fail 2 "check: unknown argument \"$1\"; agent-workflow check [FILE]" ;; esac
    [ $# -gt 1 ] && fail 2 "check: unknown argument \"$2\"; agent-workflow check [FILE]"
    file=""
    if [ $# -eq 1 ]; then
      [ -f "$1" ] || fail 1 "check: no file $1"
      case "$1" in /*) file=$1 ;; *) file=$PWD/$1 ;; esac
    fi
    payload=$(printf '{"file":%s}' "$(json_string "$file")") ;;
  run)
    workflow="" issues=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --workflow)
          [ $# -lt 2 ] && fail 2 "--workflow: give it a value"
          workflow=$2; shift 2 ;;
        --workflow=*) workflow=${1#--workflow=}; shift ;;
        --detach) detach=1; shift ;;
        --json) json=1; shift ;;
        -*) fail 2 "run: unknown argument \"$1\"; agent-workflow run ISSUE... [--workflow NAME] [--detach] [--json]" ;;
        *) issues="$issues${issues:+,}$(json_string "$1")"; shift ;;
      esac
    done
    [ -z "$issues" ] && [ -z "$workflow" ] && fail 2 "run: which issues? agent-workflow run ISSUE... [--workflow NAME], or agent-workflow run --workflow NAME (a workflow with no ticket)"
    payload=$(printf '{"issues":[%s],"workflow":%s}' "$issues" "$(json_string "$workflow")") ;;
  logs)
    issue=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -f|--follow) follow=1; shift ;;
        --json) json=1; shift ;;
        -*) fail 2 "logs: unknown argument \"$1\"; agent-workflow logs ISSUE [-f] [--json]" ;;
        *) [ -n "$issue" ] && fail 2 "logs: one issue, not \"$1\" too"; issue=$1; shift ;;
      esac
    done
    [ -z "$issue" ] && fail 2 "logs: which issue? agent-workflow logs ISSUE [-f] [--json]"
    payload=$(printf '{"issue":%s}' "$(json_string "$issue")") ;;
  status)
    case "${1:-}" in -*) fail 2 "status: unknown argument \"$1\"; agent-workflow status [ISSUE]" ;; esac
    [ $# -gt 1 ] && fail 2 "status: unknown argument \"$2\"; agent-workflow status [ISSUE]"
    payload=$(printf '{"issue":%s}' "$(json_string "${1:-}")") ;;
  done)
    outcome="" notes="" one=""
    [ $# -gt 2 ] && fail 2 "done: unknown argument \"$3\"; agent-workflow done [OUTCOME] [NOTES|-]"
    if [ $# -eq 2 ]; then outcome=$1; notes=$2
    elif [ $# -eq 1 ]; then
      # One argument: an outcome if it reads as one (a word: done changes
      # is the outcome changes, never notes), else notes; Emacs decides,
      # knowing the job's outcomes.
      if [ "$1" = "-" ]; then notes=$(cat); else one=$1; fi
    fi
    [ "$notes" = "-" ] && notes=$(cat)
    case "$outcome" in -*) fail 2 "done: unknown argument \"$outcome\"; agent-workflow done [OUTCOME] [NOTES|-]" ;; esac
    payload=$(printf '{"outcome":%s,"notes":%s,"one":%s}' "$(json_string "$outcome")" "$(json_string "$notes")" \
                     "$(json_string "$one")") ;;
  back)
    issue="" target="" notes="" discard=false have_notes=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --discard) discard=true; shift ;;
        -) notes=$(cat); have_notes=1; shift ;;
        -*) fail 2 "back: unknown argument \"$1\"; agent-workflow back ISSUE JOB[.STEP] [NOTE|-] [--discard]" ;;
        *)
          if [ -z "$issue" ]; then issue=$1
          elif [ -z "$target" ]; then target=$1
          elif [ -z "$have_notes" ]; then notes=$1; have_notes=1
          else fail 2 "back: unknown argument \"$1\"; agent-workflow back ISSUE JOB[.STEP] [NOTE|-] [--discard]"
          fi
          shift ;;
      esac
    done
    [ -z "$target" ] && fail 2 "back: to which job? agent-workflow back ISSUE JOB[.STEP] [NOTE]"
    job=${target%%.*} step=0
    if [ "$job" != "$target" ]; then
      step=${target#*.}
      case "$step" in ''|*[!0-9]*|0) fail 2 "back: $target: a step is a number from 1 (JOB.2)" ;; esac
      step=$((step - 1))
    fi
    payload=$(printf '{"issue":%s,"job":%s,"step":%d,"note":%s,"discard":%s}' \
                     "$(json_string "$issue")" "$(json_string "$job")" "$step" "$(json_string "$notes")" "$discard") ;;
  confirm)
    issue="" choice="" notes="" more=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --more-cost|--more-tokens)
          [ $# -lt 2 ] && fail 2 "$1: how much?"
          case "$2" in ''|*[!0-9.]*) fail 2 "$1: $2 isn't a number" ;; esac
          more="$more${more:+,}\"${1#--more-}\":$2"; shift 2 ;;
        --more-time)
          [ $# -lt 2 ] && fail 2 "--more-time: how long? (45m, 1h)"
          more="$more${more:+,}\"time\":$(json_string "$2")"; shift 2 ;;
        --note-to)
          [ $# -lt 3 ] && fail 2 "--note-to: a job and its note: --note-to JOB NOTE"
          notes="$notes${notes:+,}$(printf '{"job":%s,"note":%s}' "$(json_string "$2")" "$(json_string "$3")")"
          shift 3 ;;
        -*) fail 2 "confirm: unknown argument \"$1\"; agent-workflow confirm ISSUE go|accept|skip|stop|cancel [--note-to JOB NOTE]..." ;;
        *)
          if [ -z "$issue" ]; then issue=$1
          elif [ -z "$choice" ]; then choice=$1
          else fail 2 "confirm: unknown argument \"$1\"; agent-workflow confirm ISSUE go|accept|skip|stop|cancel [--note-to JOB NOTE]..."
          fi
          shift ;;
      esac
    done
    case "$choice" in
      go|accept|skip|stop|cancel) ;;
      '') fail 2 "confirm: go, accept, skip, stop or cancel? agent-workflow confirm ISSUE go|accept|skip|stop|cancel" ;;
      *) fail 2 "confirm: \"$choice\" isn't go, accept, skip, stop or cancel" ;;
    esac
    payload=$(printf '{"issue":%s,"choice":%s,"notes":[%s],"more":{%s}}' "$(json_string "$issue")" "$(json_string "$choice")" "$notes" "$more") ;;
  approve)
    [ $# -eq 0 ] && fail 2 "approve: which issue? agent-workflow approve ISSUE"
    [ $# -gt 1 ] && fail 2 "approve: unknown argument \"$2\"; agent-workflow approve ISSUE"
    payload=$(printf '{"issue":%s}' "$(json_string "$1")") ;;
  reject)
    [ $# -lt 2 ] && fail 2 "reject: which issue, and why? agent-workflow reject ISSUE NOTE"
    [ $# -gt 2 ] && fail 2 "reject: unknown argument \"$3\"; agent-workflow reject ISSUE NOTE"
    note=$2
    [ "$note" = "-" ] && note=$(cat)
    payload=$(printf '{"issue":%s,"note":%s}' "$(json_string "$1")" "$(json_string "$note")") ;;
  continue)
    issue="" current=false
    for arg in "$@"; do
      case "$arg" in
        --current) current=true ;;
        -*) fail 2 "continue: unknown argument \"$arg\"; agent-workflow continue [ISSUE] [--current]" ;;
        *) [ -n "$issue" ] && fail 2 "continue: unknown argument \"$arg\"; agent-workflow continue [ISSUE] [--current]"
           issue=$arg ;;
      esac
    done
    payload=$(printf '{"issue":%s,"current":%s}' "$(json_string "$issue")" "$current") ;;
  cancel)
    [ $# -ne 1 ] && fail 2 "cancel: which issue's run? agent-workflow cancel ISSUE"
    payload=$(printf '{"issue":%s}' "$(json_string "$1")") ;;
  pause)
    now=false
    case "${1:-}" in --now) now=true ;; '') ;; *) fail 2 "pause: unknown argument \"$1\"; agent-workflow pause [--now]" ;; esac
    payload=$(printf '{"now":%s}' "$now") ;;
  unpause)
    [ $# -gt 0 ] && fail 2 "unpause: unknown argument \"$1\""
    payload='{}' ;;
  dry-run)
    [ $# -eq 0 ] && fail 2 "dry-run: which workflow? agent-workflow dry-run WORKFLOW"
    workflow=$1; shift
    issue="" outcomes="" exits=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --issue) [ $# -lt 2 ] && fail 2 "--issue: which?"; issue=$2; shift 2 ;;
        --outcome|--exit)
          [ $# -lt 2 ] && fail 2 "$1: JOB=A,B"
          case "$2" in *=*) ;; *) fail 2 "$1 $2: JOB=A,B" ;; esac
          key=${2%%=*} values=${2#*=} list=""
          IFS=, read -r -a parts <<< "$values"
          for v in "${parts[@]}"; do
            if [ "$1" = --exit ]; then
              case "$v" in ''|*[!0-9]*) fail 2 "--exit $2: exit codes are numbers" ;; esac
              list="$list${list:+,}$v"
            else
              list="$list${list:+,}$(json_string "$v")"
            fi
          done
          entry="$(json_string "$key"):[$list]"
          if [ "$1" = --exit ]; then exits="$exits${exits:+,}$entry"; else outcomes="$outcomes${outcomes:+,}$entry"; fi
          shift 2 ;;
        *) fail 2 "dry-run: unknown argument \"$1\"" ;;
      esac
    done
    payload=$(printf '{"workflow":%s,"issue":%s,"outcomes":{%s},"exits":{%s}}' \
                     "$(json_string "$workflow")" "$(json_string "$issue")" "$outcomes" "$exits") ;;
  *)
    fail 2 "unknown operation \"$op\"; operations: run, done, back, confirm, approve, reject, continue, cancel, pause, unpause, dry-run, check, logs, status" ;;
esac

dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-workflow.XXXXXXXXXX") || fail 3 "no temp folder"
trap 'rm -rf "$dir"' EXIT
printf '%s\n%s\n%s\n' "$op" "$PWD" "$$" >"$dir/request"
printf '%s' "$payload" >"$dir/payload"

# On Linux emacsclient looks for its server under $XDG_RUNTIME_DIR/emacs/, or,
# without that variable (cron), in ${TMPDIR:-/tmp}/emacsUID/ only: a desktop
# Emacs's is in /run/user/UID/emacs/. AGENT_WORKFLOW_RUNTIME_DIR: that folder
# elsewhere (the tests).
if [ -z "${EMACS_SOCKET_NAME:-}" ] && [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  runtime=${AGENT_WORKFLOW_RUNTIME_DIR:-/run/user/$(id -u)}
  [ -S "$runtime/emacs/server" ] && export EMACS_SOCKET_NAME="$runtime/emacs/server"
fi

# The folder as a Lisp string.
lisp_dir=${dir//\\/\\\\}
lisp_dir=${lisp_dir//\"/\\\"}
out=$("${EMACSCLIENT:-emacsclient}" --timeout=60 --eval \
        "(if (fboundp 'agent-workflow-request) (agent-workflow-request \"$lisp_dir\") 'agent-workflow-not-loaded)" 2>&1)
status=$?

# FOLLOWING RUNS
# Their logs (journals, --json) printed as they grow, read every second,
# their complete lines only, until each run's state.json says it's over:
# then once more, its last lines. No process of its own to leave behind:
# Ctrl-C stops it, never the runs (Emacs runs them).
field() {  # field NAME JSON: each string value of NAME in JSON, a line each
  printf '%s' "$2" | grep -o "\"$1\":\"[^\"]*\"" | sed "s/^\"$1\":\"//; s/\"\$//"
}

follow() {  # follow ISSUES LOGS STATES: newline-separated, in order; exit 0 all done, 1 one cancelled or failed
  local issues logs states i n file state all failed last=""
  IFS=$'\n' read -r -d '' -a issues <<< "$1"
  IFS=$'\n' read -r -d '' -a logs <<< "$2"
  IFS=$'\n' read -r -d '' -a states <<< "$3"
  local seen=()
  trap 'exit 130' INT TERM
  while :; do
    all=1 failed=0
    for i in "${!issues[@]}"; do
      file=${logs[$i]}
      if [ -f "$file" ]; then
        n=$(wc -l < "$file" | tr -d ' ')
        if [ "$n" -gt "${seen[$i]:-0}" ]; then
          if [ -n "$json" ]; then
            sed -n "$((${seen[$i]:-0} + 1)),${n}p" "$file" |
              sed "s/^{/{\"issue\":$(json_string "${issues[$i]}" | sed 's/[&/\\]/\\&/g'),/"
          else
            sed -n "$((${seen[$i]:-0} + 1)),${n}p" "$file"
          fi
          seen[$i]=$n
        fi
      fi
      state=$(grep -o '"state":"[a-z]*"' "${states[$i]}" 2>/dev/null | head -1)
      case "$state" in
        *'"done"') ;;
        *'"cancelled"'|*'"failed"') failed=1 ;;
        *) all=0 ;;
      esac
    done
    if [ $all -eq 1 ]; then
      [ -n "$last" ] && return $failed
      last=1
    else
      sleep 1
    fi
  done
}

if [ -f "$dir/reply" ]; then
  reply=$(cat "$dir/reply")
  ok=""; case "$reply" in '{"ok":true'*) ok=1 ;; esac
  case "$op" in
    run)
      if [ -n "$detach" ] || [ -z "$ok" ]; then
        printf '%s\n' "$reply"
        [ -n "$ok" ] && exit 0
        exit 1
      fi
      if [ -n "$json" ]; then
        printf '%s\n' "$reply"
        logs=$(field journal "$reply")
      else
        logs=$(field log "$reply")
        refused=$(printf '%s' "$reply" | grep -o '"refused":\[.*\]' )
        case "$refused" in '"refused":[]') ;; *) printf 'refused: %s\n' "${refused#\"refused\":}" >&2 ;; esac
      fi
      follow "$(field issue "$(printf '%s' "$reply" | grep -o '"started":\[[^]]*\]')")" "$logs" "$(field state_file "$reply")"
      exit $? ;;
    logs)
      [ -z "$ok" ] && { printf '%s\n' "$reply"; exit 1; }
      if [ -n "$json" ]; then file=$(field journal "$reply"); else file=$(field log "$reply"); fi
      if [ -n "$follow" ]; then
        follow "$(field issue "$reply")" "$file" "$(field state_file "$reply")"
        exit $?
      fi
      cat "$file"
      exit 0 ;;
  esac
  printf '%s\n' "$reply"
  [ -n "$ok" ] && exit 0
  exit 1
fi
case "$out" in
  *agent-workflow-not-loaded*) fail 3 "Emacs runs, but without agent workflows (config/agent-workflow.el)" ;;
esac
[ $status -ne 0 ] && fail 3 "no Emacs server answered (M-x server-start): ${out//$'\n'/ }"
fail 3 "Emacs didn't answer: ${out//$'\n'/ }"
