#!/usr/bin/env bash
# cmd/agent-workflow: the agent-workflow package's command line (its
# bin/agent-workflow, as Doom built it from packages.el), for this config's
# docs, scripts and workflows: the same arguments, replies and exit statuses.
# agent-workflow -h says them; see ~/dev/agent-workflow
# (docs/command-line.md).
#
# DOOM_EMACS_DIR (default: ~/.config/emacs) is where Doom built it.

emacs_dir=${DOOM_EMACS_DIR:-$HOME/.config/emacs}
for cmd in "$emacs_dir"/.local/straight/build-*/agent-workflow/bin/agent-workflow; do
  [ -x "$cmd" ] && exec "$cmd" "$@"
done
printf '{"ok":false,"error":"the agent-workflow package isn'"'"'t installed (packages.el, doom sync)"}\n'
exit 3
