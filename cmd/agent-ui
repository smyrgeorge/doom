#!/usr/bin/env bash
# cmd/agent-ui: the agent-ui package's command line (its bin/agent-ui, as
# Doom built it from packages.el), for this config's docs and scripts: the
# same arguments, replies and exit statuses. agent-ui -h says them; see
# ~/dev/agent-ui (docs/command-line.md).
#
# DOOM_EMACS_DIR (default: ~/.config/emacs) is where Doom built it.

emacs_dir=${DOOM_EMACS_DIR:-$HOME/.config/emacs}
for cmd in "$emacs_dir"/.local/straight/build-*/agent-ui/bin/agent-ui; do
  [ -x "$cmd" ] && exec "$cmd" "$@"
done
printf '{"ok":false,"error":"the agent-ui package isn'"'"'t installed (packages.el, doom sync)"}\n'
exit 3
