#!/usr/bin/env bash
# The agent workspace from the shell: a crew of coding agents on one project
# (config/agent-workspace.el), for your scripts. See docs/agent-workspace.md.
#
#   agent-workspace new --role ROLE [--name NAME] [--prompt TEXT]
#                                a new agent in this folder's project: its
#                                worktree made, its session started; NAME
#                                left out, one is made for it; TEXT its
#                                first message -> {"ok": true, "name",
#                                "role", "worktree", "branch", "state"}
#   agent-workspace send --to NAME|#ROLE|#all [--from SOURCE] TEXT|-
#                                an event for an agent, a role's first free
#                                agent or every agent (TEXT, or - for stdin),
#                                from SOURCE (default: shell): delivered when
#                                it's free, as data, never instructions
#                                -> {"ok": true, "events": [{"id", "to",
#                                "state": "queued"|"delivered"}]}; from an
#                                agent's shell (AGENT_WORKSPACE_AGENT), no
#                                --from: its message to another agent,
#                                "waiting" for your OK if the crew asks
#
# The reply is JSON on stdout: {"ok": false, "error": "what's wrong"} when it
# isn't done. Exit status: 0 done, 1 not done (the reply says why), 2 a wrong
# use, 3 no Emacs to talk to (it runs as a server: M-x server-start).
#
# EMACSCLIENT (default: emacsclient) is the client, EMACS_SOCKET_NAME its
# server.

set -u

usage() { sed -n '2,/^$/{s/^# \{0,1\}//;p;}' "$0"; }

json_string() {  # json_string TEXT: TEXT as a JSON string
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  printf '"%s"' "$s"
}

fail() {  # fail STATUS MESSAGE: the reply for an error, and exit
  printf '{"ok":false,"error":%s}\n' "$(json_string "$2")"
  exit "$1"
}

[ $# -eq 0 ] && { usage >&2; exit 2; }
case "$1" in -h|--help|help) usage; exit 0 ;; esac

op=$1; shift
case "$op" in
  new)
    role="" name="" prompt=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --role|--name|--prompt)
          [ $# -lt 2 ] && fail 2 "$1: give it a value"
          case "$1" in
            --role) role=$2 ;; --name) name=$2 ;; --prompt) prompt=$2 ;;
          esac
          shift 2 ;;
        --role=*) role=${1#--role=}; shift ;;
        --name=*) name=${1#--name=}; shift ;;
        --prompt=*) prompt=${1#--prompt=}; shift ;;
        *) fail 2 "new: unknown argument \"$1\"; agent-workspace new --role ROLE [--name NAME] [--prompt TEXT]" ;;
      esac
    done
    [ -z "$role" ] && fail 2 "new: which role? agent-workspace new --role ROLE"
    payload=$(printf '{"role":%s,"name":%s,"prompt":%s}' \
                     "$(json_string "$role")" "$(json_string "$name")" "$(json_string "$prompt")") ;;
  send)
    to="" from="" text="" have_text=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --to|--from)
          [ $# -lt 2 ] && fail 2 "$1: give it a value"
          case "$1" in --to) to=$2 ;; --from) from=$2 ;; esac
          shift 2 ;;
        --to=*) to=${1#--to=}; shift ;;
        --from=*) from=${1#--from=}; shift ;;
        -) text=$(cat); have_text=1; shift ;;
        --) shift; text="$*"; have_text=1; break ;;
        -*) fail 2 "send: unknown argument \"$1\"; agent-workspace send --to NAME|#ROLE|#all [--from SOURCE] TEXT|-" ;;
        *) text="$*"; have_text=1; break ;;
      esac
    done
    [ -z "$to" ] && fail 2 "send: to whom? agent-workspace send --to NAME|#ROLE|#all TEXT"
    [ -z "$have_text" ] && fail 2 "send: what? agent-workspace send --to $to TEXT (or - to read it)"
    agent=""
    [ -z "$from" ] && agent=${AGENT_WORKSPACE_AGENT:-}
    payload=$(printf '{"to":%s,"from":%s,"text":%s,"agent":%s}' \
                     "$(json_string "$to")" "$(json_string "$from")" "$(json_string "$text")" \
                     "$(json_string "$agent")") ;;
  *)
    fail 2 "unknown operation \"$op\"; operations: new, send" ;;
esac

dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-workspace.XXXXXXXXXX") || fail 3 "no temp folder"
trap 'rm -rf "$dir"' EXIT
printf '%s\n%s\n' "$op" "$PWD" >"$dir/request"
printf '%s' "$payload" >"$dir/payload"

# The folder as a Lisp string.
lisp_dir=${dir//\\/\\\\}
lisp_dir=${lisp_dir//\"/\\\"}
out=$("${EMACSCLIENT:-emacsclient}" --timeout=60 --eval \
        "(if (fboundp 'agent-workspace-request) (agent-workspace-request \"$lisp_dir\") 'agent-workspace-not-loaded)" 2>&1)
status=$?

if [ -f "$dir/reply" ]; then
  cat "$dir/reply"
  grep -q '^{"ok":true' "$dir/reply" && exit 0
  exit 1
fi
case "$out" in
  *agent-workspace-not-loaded*) fail 3 "Emacs runs, but without the agent workspace (config/agent-workspace.el)" ;;
esac
[ $status -ne 0 ] && fail 3 "no Emacs server answered (M-x server-start): ${out//$'\n'/ }"
fail 3 "Emacs didn't answer: ${out//$'\n'/ }"
